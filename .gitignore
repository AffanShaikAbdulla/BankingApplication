# Maven build output
**/target/
**/target/**/*

# Generated files
**/META-INF/
**/MANIFEST.MF

# Java compiled files
**/*.class
**/*.jar

# IDE files
.settings/
.project
.classpath
.idea/
*.iml
.vscode/

# OS files
.DS_Store
Thumbs.db
desktop.ini

